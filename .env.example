# RequestFlow AI lean MVP configuration.
# Copy values into your local shell, Vercel env settings, or hosting provider.
# Never commit a real .env file.

# Neon uses the standard Postgres URL. The app converts this to JDBC at startup.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Required when SPRING_PROFILES_ACTIVE=prod and REQUESTFLOW_SECURITY_PROVIDER=basic.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH="{bcrypt}replace_with_a_bcrypt_hash"
ADMIN_ORGANIZATION_NAME="RequestFlow AI"

# Frontend/backend origins.
FRONTEND_URL="http://localhost:8080"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REQUESTFLOW_API_BASE_URL="http://localhost:8080"
REQUESTFLOW_AUTH_MODE="basic"
REQUESTFLOW_PUBLIC_ORGANIZATION_SLUG="local"

# Optional paid-AI extension. Leave blank to use the rule-based fallback.
OPENAI_API_KEY="your_openai_api_key_here"

# Optional Stripe test-mode billing foundation. Leave blank until you run Stripe drills.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""

# Optional email notifications.
INTAKE_NOTIFICATION_EMAIL_ENABLED="true"
INTAKE_NOTIFICATION_EMAIL_MODE="log"
INTAKE_NOTIFICATION_FROM="requestflow@localhost"
INTAKE_NOTIFICATION_FALLBACK_RECIPIENT=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Legacy AWS/Cognito variables are not needed for the default Vercel + Neon MVP path.
